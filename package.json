{
  "name": "iikawa-pet",
  "version": "0.2.0",
  "description": "이이카와 데스크탑 다마고치 - 페르세포네, 사토, 자스민을 바탕화면에서 키우자",
  "main": "src/main.js",
  "author": "iikawa",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.iikawa.pet",
    "productName": "IikawaPet",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "IikawaPet-${version}.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  }
}